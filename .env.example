# Leave these unset to use the local (localStorage) mock backend for dev/testing.
# Fill both in to switch the app to your real Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Sheet sync (optional). Paste the Apps Script web app URL and the same
# token you set as SHEET_TOKEN in the script — see google-sheets/README.md.
VITE_GOOGLE_SHEET_WEBHOOK_URL=
VITE_GOOGLE_SHEET_TOKEN=

# Set as Supabase function secrets (not read by the frontend):
#   supabase secrets set SENDGRID_API_KEY=... SENDGRID_FROM_EMAIL=...
