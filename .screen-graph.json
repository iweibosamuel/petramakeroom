xtPending)}\n            className={primaryButtonClass}\n          >\n            I've paid {money(nextPending.amount)}\n          </button>\n        </StickyAction>\n      )}\n\n      {confirming && (\n        <ConfirmPaymentSheet\n          pledgeId={pledge.id}\n          installment={confirming}\n          currency={pledge.currency}\n          onClose={() => setConfirming(null)}\n          onConfirmed={() => {\n            setConfirming(null);\n            loadPledge();\n          }}\n        />\n      )}\n    </GiveShell>",
